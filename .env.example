# Copy to .env and fill in what you need. All optional.
PDF_DIR=/path/to/pdfs
DATA_DIR=data
OUTPUT_DIR=outputs
# DEC export from the USAID librarian, for document-type/country controls
METADATA_CSV=
META_FILENAME_COL=
META_DOCTYPE_COL=
META_COUNTRY_COL=
# Only needed for --gpt-labels (display-only labels)
OPENAI_API_KEY=
